#!/bin/sh
# Normal pushes check irreversible bulk-delete/rename risk only.
# Syntax is checked by npm run check:syntax (and during LOC builds).
# This hook checks only the net file deletion/rename count.
# Enable once per clone: git config core.hooksPath .githooks
set -e
echo "pre-push: checking mass deletion/rename safety..."
node scripts/check-bulk-delete.mjs
