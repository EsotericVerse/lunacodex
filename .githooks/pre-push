#!/bin/sh
# A local push must carry real syntax evidence; env flags cannot bypass it.
# Enable once per clone: git config core.hooksPath .githooks
# Server-side PR syntax verification is in workflow-guard.yml.
set -e
echo "pre-push: verifying syntax (no bypass)..."
node scripts/check-js-syntax.mjs
echo "pre-push: checking mass deletion/rename safety..."
node scripts/check-bulk-delete.mjs
