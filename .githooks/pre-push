#!/bin/sh
# Normal pushes check irreversible bulk-delete/rename risk only.
# If work was interrupted or recovery is uncertain, run npm run check:syntax
# first (or the manual Workflow guard in GitHub Actions if npm is unavailable).
# Enable once per clone: git config core.hooksPath .githooks
set -e
echo "pre-push: checking mass deletion/rename safety..."
node scripts/check-bulk-delete.mjs
