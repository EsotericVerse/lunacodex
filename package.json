{
  "name": "loc-framework",
  "version": "1.1.1-rc.7",
  "private": true,
  "scripts": {
    "prepare": "node scripts/prepare-local-workspace.mjs",
    "prebuild": "node scripts/sync-page-locale-assets.mjs && node scripts/stage-loc-pics.mjs && node scripts/check-js-syntax.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/sync-zenstack-schema-contract.mjs && node scripts/build-static-export.mjs",
    "audit:static": "node scripts/audit-static-content.mjs",
    "test:static-assets": "node --test tests/static-export-assets.test.mjs",
    "sync:scope-routes": "node scripts/sync-scope-route-index.mjs",
    "sync:public": "node scripts/generate-public-blocks.mjs",
    "check:syntax": "node scripts/check-js-syntax.mjs",
    "check:bulk-delete": "node scripts/check-bulk-delete.mjs",
    "predev": "node scripts/sync-page-locale-assets.mjs && node scripts/stage-loc-pics.mjs"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.18",
    "@blocknote/core": "0.55.0",
    "@blocknote/ariakit": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/share": "8.0.0",
    "@streamparser/json": "0.0.26",
    "@zenstackhq/orm": "3.10.2",
    "@zenstackhq/plugin-policy": "3.10.2",
    "@zenstackhq/zod": "3.10.2",
    "better-auth": "1.7.18",
    "fflate": "0.8.3",
    "immer": "^11.2.10",
    "jsonpath-plus": "11.2.2",
    "karaul": "0.1.0",
    "kysely": "0.29.9",
    "maplibre-gl": "6.16.0",
    "modern-ahocorasick": "3.3.0",
    "motion": "13.4.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "vis-data": "8.0.6",
    "vis-network": "10.1.5",
    "vis-timeline": "8.5.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "7.29.14",
    "@capacitor/ios": "8.5.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2",
      "cuid": "npm:@paralleldrive/cuid2@2.3.1",
      "uuid": "11.1.1",
      "use-sync-external-store": "1.6.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
