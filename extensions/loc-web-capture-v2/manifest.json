{
  "manifest_version": 3,
  "name": "LOC galaxy-link｜彩虹橋",
  "version": "0.1.0",
  "description": "連接屬於你的文字銀河。擷取網頁、動態內容與舊對話，批次存入 LOC 銀河。",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://loc.lo3rwang.cc/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LOC galaxy-link｜彩虹橋",
    "default_popup": "popup.html"
  }
}
