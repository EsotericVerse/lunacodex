{
  "manifest_version": 3,
  "name": "LOC 網頁短匯入",
  "version": "0.3.0",
  "description": "LOC Auth 一次授權；使用者主動擷取網頁並直接短匯入 LOC，不經 Clerk 或 KV",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://loc.lo3rwang.cc/*",
    "https://mcp.lo3rwang.cc/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "LOC 網頁短匯入設定"
  }
}
