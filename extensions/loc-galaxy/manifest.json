{
  "manifest_version": 3,
  "name": "LOC Galaxy",
  "short_name": "LOC Galaxy",
  "version": "0.6.6",
  "description": "LOC Galaxy website Clerk Session bridge, private Galaxy recording and ChatGPT capture.",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://loc.lo3rwang.cc/*",
    "https://precise-grackle-3371.clerk.accounts.dev/*"
  ],
  "background": {
    "service_worker": "background-entry.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LOC Galaxy",
    "default_icon": {
      "16": "icons/loc-favicon.png",
      "32": "icons/loc-favicon.png"
    }
  },
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/loc-favicon.png",
    "32": "icons/loc-favicon.png",
    "48": "icons/loc-favicon.png",
    "128": "icons/loc-favicon.png"
  },
  "optional_host_permissions": [
    "https://chatgpt.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://loc.lo3rwang.cc/*"
    ]
  }
}
