{
  "manifest_version": 3,
  "name": "LOC Galaxy",
  "short_name": "LOC Galaxy",
  "version": "0.2.0",
  "description": "LOC Galaxy workspace: Clerk OAuth, private MCP topic browser, and authorized Scope import/update entry.",
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://loc.lo3rwang.cc/*",
    "https://precise-grackle-3371.clerk.accounts.dev/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LOC Galaxy",
    "default_icon": {
      "16": "icons/loc-favicon.png",
      "32": "icons/loc-favicon.png"
    }
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/loc-favicon.png",
    "32": "icons/loc-favicon.png",
    "48": "icons/loc-favicon.png",
    "128": "icons/loc-favicon.png"
  }
}
