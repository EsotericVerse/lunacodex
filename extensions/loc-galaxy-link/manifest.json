{
  "manifest_version": 3,
  "name": "LOC galaxy-link｜LOC 彩虹橋",
  "version": "0.2.8",
  "description": "單一 LOC 彩虹橋：OAuth PKCE、Neon／Supabase MCP SSO、網頁／選區／對話／動態錄製、離線 Queue 與 Append 匯入",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://loc.lo3rwang.cc/*",
    "https://auth.lo3rwang.cc/*",
    "https://mcp.lo3rwang.cc/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "LOC galaxy-link｜LOC 彩虹橋",
    "default_icon": {
      "16": "icons/loc-favicon.png",
      "48": "icons/loc-favicon.png",
      "128": "icons/loc-favicon.png"
    }
  },
  "short_name": "LOC 彩虹橋",
  "icons": {
    "16": "icons/loc-favicon.png",
    "48": "icons/loc-favicon.png",
    "128": "icons/loc-favicon.png"
  },
  "key": ""
}
