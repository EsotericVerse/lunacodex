// LOC fixed physical schema — read-only model snapshot of PostgreSQL silver + api tables.
// No migrations are generated/applied from this file. No SQL procedures are required.
// Additional product features reuse the existing Anchor.attr JSON payload.
// Portable MySQL / SQL Server / SQLite query construction remains in Kysely adapters.
// SQL-nullable array columns cannot be modeled as nullable lists in ZModel V3;
// their null-preserving read/write behavior must stay on the Kysely path.
// LOC Auth's delegated principal must be verified by the trusted server before DB access.
// The public control-plane and presentation models use ZenStack PolicyPlugin
// for SELECT; Blocks are included so Hero/home reads stay on the typed path.
// dynamic Scope Galaxy/Anchor row visibility remains in delegated Kysely + RLS.

datasource db {
    provider = "postgresql"
    url = env("LOC_DATABASE_URL")
    schemas = ["silver", "api"]
}

plugin policy {
    provider = '@zenstackhq/plugin-policy'
}

// Verified LOC OAuth + delegated role principal. This is NOT a database table.
// Group is a virtual Scope-management tier, not a User/Group record.
// All scopeIds/groupIds are projected from verified LOC grants and trusted
// server-side membership; they cannot be supplied by the browser.
type LocPrincipal {
    id        String
    role      String
    roleLevel Int
    scopeIds  String[]
    groupIds  String[]
    @@auth
}

// Nonphysical projections for federated LOC data. Neither declaration creates
// a relation or claims that data from different databases has been synchronized.
// Physical primary keys remain the local eight-character Base62 UID.
type LocFederatedRef {
    databaseId String
    scopeId    String
    uid        String
}

// Typed relationship output over *already authorized and scoped* Anchor rows.
// Link resolution never grants write access or implies a cross-database FK.
type LocAnchorLink {
    family   String
    fromUid  String
    toUid    String
    fromType String
    toType   String
    attrKey  String
    resolved Boolean
}

// Persisted Anchor discriminators. The SQL row remains one portable storage
// envelope; these values select the semantic ZModel payload below. Their
// article-side carrier mapping is date/createtime, location/place_id,
// media_link, keyword and site respectively; no extra relation is created.
enum LocAnchorType {
    date
    period
    era
    point
    path
    trace
    image
    video
    rune
    suno
    pattern
    item
    group
    class
    category
    from
    domain
    galaxy
    universe
}

// Semantic ZModel payloads for Anchor.attr. These are nonphysical value types:
// they do not create tables and are validated through @zenstackhq/zod against
// the existing Anchor row. Anniversary remains a derived suggestion.
type DateAnchor {
    date String
}
type PeriodAnchor {
    uid String[]?
    date String[]?
}
type EraAnchor {
    period String[]?
    date String[]?
}
type PointAnchor {
    longitude Float?
    latitude Float?
    location String?
    times String[]?
}
type PathAnchor {
    point String[]?
}
type TraceAnchor {
    point String[]?
    path String[]?
}
type ImageAnchor {
    url String?
    date String?
}
type VideoAnchor {
    url String?
    date String?
}
type RuneAnchor {
    url String?
    date String?
}
type SunoAnchor {
    url String?
    date String?
}
type PatternAnchor {
    postings Json?
}
type ItemAnchor {
    keyword String[]?
    uid String[]?
    total Int?
}
type GroupAnchor {
    uid String[]?
}
type ClassAnchor {
    uid String[]?
}
type CategoryAnchor {
    uid String[]?
}
type FromAnchor {
    uid String[]?
}
type DomainAnchor {
    uid String[]?
}
type GalaxyAnchor {
    uid String[]?
}
type UniverseAnchor {
    uid String[]?
}
type AnniversarySuggestion {
    date String
    years Int
    sourceUid String?
    title String
}

// Group models are the public semantic names. Each discriminator is wrapped
// in its group field and validated against the existing subtype payload; this
// keeps one strict ZModel boundary without creating one SQL table per type.
type TimeAnchor {
    date DateAnchor?
    period PeriodAnchor?
    era EraAnchor?
    anniversary AnniversarySuggestion?
}
type LocationAnchor {
    point PointAnchor?
    path PathAnchor?
    trace TraceAnchor?
}
type MediaAnchor {
    images ImageAnchor?
    video VideoAnchor?
    suno SunoAnchor?
    runes RuneAnchor?
}
type KeywordAnchor {
    pattern PatternAnchor?
    item ItemAnchor?
    group GroupAnchor?
    class ClassAnchor?
    category CategoryAnchor?
}
type SiteAnchor {
    from FromAnchor?
    domain DomainAnchor?
    galaxy GalaxyAnchor?
    universe UniverseAnchor?
}

// The 66-card rune catalogue is a separate semantic projection. Its physical
// source remains the existing silver.runes model; it is not an Anchor subtype.
type LRunes66 {
    rune_id Int
    rune_name String?
    english_name String?
    totem String?
    group_name String?
    moon_phase Int?
    card_attr Int?
    rune_description String?
    archetype String?
    char_action String?
    positive_keywords String?
    negative_keywords String?
    extra_rules String?
    extra_notes String?
    positive_meaning String?
    half_positive_meaning String?
    half_reverse_meaning String?
    reverse_meaning String?
    rune_evolution_history String?
    myth_story String?
    soul_question String?
    practice_challenge String?
    ritual_advice String?
    harmony_advice String?
    class_enable Boolean?
}

// Galaxy read projections. These are semantic result types over one physical
// <scope>_galaxy table; they do not create duplicate tables or JOINs.
type GalaxyAttr {
    statics Boolean?
    culture Boolean?
    search Boolean?
    trace Boolean?
    list Boolean?
    keyword Boolean?
    extract Boolean?
    others Boolean?
}
type GalaxyList {
    uid String
    title String?
    createtime DateTime?
    date DateTime?
    site String?
    statics Boolean?
    culture Boolean?
    search Boolean?
    trace Boolean?
    list Boolean?
    keyword Boolean?
    extract Boolean?
    others Boolean?
}
type GalaxyUidRelation {
    uid String
    source_id String?
    target_id String[]?
    ref_id String?
}
type GalaxyUidAnchor {
    uid String
    media_link String[]?
    place_id String?
    location String?
    date DateTime?
    site String?
}
type GalaxyUidRead {
    uid String
    title String?
    content String?
    createtime DateTime?
    url String?
    source_id String?
    target_id String[]?
    ref_id String?
    media_link String[]?
    place_id String?
    location String?
    date DateTime?
    site String?
}

model Game {
    game_key                     String      @id @db.Text
    record_type                  String      @db.Text
    sort_order                   Int         @db.Integer @default(0)
    status                       String      @db.Text @default(dbgenerated())
    is_current                   Boolean      @default(true)
    event_id                     String?     @db.Text
    event_group                  String?     @db.Text
    event_title                  String?     @db.Text
    event_requirement            String?     @db.Text
    event_description            String?     @db.Text
    rune_id                      Int?        @db.Integer
    rune_name                    String?     @db.Text
    rune_group                   String?     @db.Text
    rune_action_text             String?     @db.Text
    rune_action_kind             String?     @db.Text
    rune_action_value            Int?        @db.Integer
    role_id                      Int?        @db.Integer
    role_formal_name             String?     @db.Text
    role_public_name             String?     @db.Text
    role_group                   String?     @db.Text
    role_core_function           String?     @db.Text
    role_intervention_type       String?     @db.Text
    role_intervention_name       String?     @db.Text
    role_tool                    String?     @db.Text
    role_tagline                 String?     @db.Text
    rule_code                    String?     @db.Text
    rule_title                   String?     @db.Text
    rule_text                    String?     @db.Text
    macro_code                   String?     @db.Text
    macro_group_a                String?     @db.Text
    macro_group_b                String?     @db.Text
    macro_title                  String?     @db.Text
    macro_description            String?     @db.Text
    asset_code                   String?     @db.Text
    asset_kind                   String?     @db.Text
    asset_group                  String?     @db.Text
    asset_path                   String?     @db.Text
    asset_title                  String?     @db.Text
    source_note                  String?     @db.Text
    updated_at                   DateTime    @db.Timestamptz(6) @default(now())
    rule_round_no                Int?        @db.Integer
    rule_phase                   String?     @db.Text
    rule_result_code             String?     @db.Text
    rule_de_delta                Int?        @db.Integer
    rule_draw_count              Int?        @db.Integer
    rule_value_int               Int?        @db.Integer
    rule_value_text              String?     @db.Text
    asset_group_2                String?     @db.Text
    event_group_2                String?     @db.Text
    @@map("game")
    @@schema("silver")
}

model Lo3rwang {
    id                           String      @id @db.Text
    style                        Int?        @db.Integer
    theme                        String      @db.Text @default(dbgenerated())
    updated_at                   DateTime    @db.Timestamptz(6) @default(now())
    keyword_min_chars            Int         @db.Integer @default(32)
    keyword_min_documents        Int         @db.Integer @default(100)
    staticstime                  DateTime?   @db.Timestamptz(6)
    keyword_class_share_enabled  Boolean      @default(false)
    keyword_meta                 Json        @db.JsonB @default(dbgenerated())
    display_name                 String      @db.Text
    search_intro                 String      @db.Text @default(dbgenerated())
    search_aliases               String[]    @db.Text @default(dbgenerated())
    locale                       String      @db.Text @default(dbgenerated())
    current_keyword_class_uid    String?     @db.Char(8)
    keyword_suggestions          String[]    @db.Text
    status                       Json        @db.JsonB @default(dbgenerated())
    trace                        Boolean      @default(true)
    search                       Boolean      @default(true)
    culture                      Boolean      @default(true)
    statics                      Boolean      @default(true)
    @@map("lo3rwang")
    @@schema("silver")
    @@allow('read', true)
}

// LOC-wide source keyword anchors. Hierarchy is represented by attr.uid (child UIDs),
// never by title. attr.counts stores per-Scope cached article counts.
// Physical schema matches Lo3rwangAnchor; source-specific CHECK constraints live in SQL.
model LocAnchor {
    uid                          String      @id @db.Char(8)
    type                         String      @db.Text
    title                        String?     @db.Text
    description                  String?     @db.Text
    invisible                    Boolean     @default(false)
    attr                         Json        @db.JsonB @default(dbgenerated())
    createtime                   DateTime?   @db.Timestamptz(6) @default(dbgenerated())
    num                          BigInt      @db.BigInt @default(0)
    @@allow('read', true)
    @@map("loc_anchor")
    @@schema("silver")
}

model Lo3rwangAnchor {
    uid                          String      @id @db.Char(8)
    type                         String      @db.Text
    title                        String?     @db.Text
    description                  String?     @db.Text
    invisible                    Boolean      @default(false)
    attr                         Json        @db.JsonB @default(dbgenerated())
    createtime                   DateTime?   @db.Timestamptz(6) @default(dbgenerated())
    num                          BigInt      @db.BigInt @default(0)
    @@map("lo3rwang_anchor")
    @@schema("silver")
}

model Lo3rwangBlocks {
    block_title                  String      @db.VarChar(64) @default(dbgenerated())
    block_text                   String      @db.Text @default(dbgenerated())
    block_order                  Int         @db.Integer
    uid                          String      @id @db.Char(8)
    page_name                    String      @db.Text
    block_entity                 Json        @db.JsonB @default(dbgenerated())
    block_eyebrow                String      @db.VarChar(64) @default(dbgenerated())
    block_subtitle               String      @db.VarChar(128) @default(dbgenerated())
    block_image                  String?     @db.Text
    @@allow('read', true)
    @@map("lo3rwang_blocks")
    @@schema("silver")
}

model Lo3rwangGalaxy {
    uid                          String      @id @db.Char(8)
    title                        String?     @db.Text
    content                      String?     @db.Text
    createtime                   DateTime?   @db.Timestamptz(6)
    location                     String?     @db.Text
    UpdateTime                   DateTime    @db.Timestamptz(6) @default(now())
    url                          String?     @db.Text
    source_id                    String?     @db.Char(8)
    target_id                    String[]    @db.Text
    ref_id                       String?     @db.Char(8)
    site                         String?     @db.Text
    place_id                     String?     @db.Char(8)
    media_link                   String[]    @db.VarChar
    date                         DateTime?   @db.Date
    site_id                      String?     @db.Text
    culture                      Boolean?     @default(false)
    trace                        Boolean?     @default(false)
    search                       Boolean?     @default(false)
    statics                      Boolean?     @default(false)
    list                         Boolean?     @default(false)
    extract                      Boolean?     @default(false)
    others                       Boolean?     @default(false)
    keyword                      Boolean?     @default(false)
    @@map("lo3rwang_galaxy")
    @@schema("silver")
}

model Loc {
    id                           String      @id @db.Text
    display_name                 String      @db.Text
    locale                       String      @db.Text @default(dbgenerated())
    ArticleTag                   Json        @db.JsonB @default(dbgenerated())
    theme                        Json        @db.JsonB @default(dbgenerated())
    keywords                     Json        @db.JsonB @default(dbgenerated())
    title_tw                     String?     @db.Text
    desc_tw                      String?     @db.Text
    birthday                     DateTime?   @db.Date
    @@map("loc")
    @@schema("silver")
    @@allow('read', true)
    @@allow('update,delete', auth().roleLevel >= 4)

}

// Semantic ZModel projection; LOC Blocks are stored in LocAnchor, not a second table.
// uid=uid, page_name=type, block_title=title, block_text=description,
// block_order=num, remaining fields live in attr (uidlist/eyebrow/subtitle/image).
type LocBlocks {
    uid String
    page_name String
    block_title String
    block_text String
    block_order Int
    block_entity Json
    block_eyebrow String
    block_subtitle String
    block_image String?
}

model Lrunes {
    id                           String      @id @db.Text
    style                        Int?        @db.Integer
    theme                        String      @db.Text @default(dbgenerated())
    updated_at                   DateTime    @db.Timestamptz(6) @default(now())
    display_name                 String      @db.Text
    search_intro                 String      @db.Text @default(dbgenerated())
    search_aliases               String[]    @db.Text @default(dbgenerated())
    locale                       String      @db.Text @default(dbgenerated())
    keyword_min_chars            Int         @db.Integer @default(32)
    keyword_min_documents        Int         @db.Integer @default(100)
    keyword_class_share_enabled  Boolean      @default(false)
    keyword_meta                 Json        @db.JsonB @default(dbgenerated())
    staticstime                  DateTime?   @db.Timestamptz(6)
    current_keyword_class_uid    String?     @db.Char(8)
    status                       Json        @db.JsonB @default(dbgenerated())
    trace                        Boolean      @default(true)
    search                       Boolean      @default(true)
    culture                      Boolean      @default(true)
    statics                      Boolean      @default(true)
    @@map("lrunes")
    @@schema("silver")
    @@allow('read', true)
}

model LrunesAnchor {
    uid                          String      @id @db.Char(8)
    type                         String      @db.Text
    title                        String?     @db.Text
    description                  String?     @db.Text
    invisible                    Boolean      @default(false)
    attr                         Json        @db.JsonB @default(dbgenerated())
    createtime                   DateTime?   @db.Timestamptz(6) @default(dbgenerated())
    num                          BigInt      @db.BigInt @default(0)
    @@map("lrunes_anchor")
    @@schema("silver")
}

model LrunesBlocks {
    block_title                  String      @db.VarChar(64) @default(dbgenerated())
    block_text                   String      @db.Text @default(dbgenerated())
    block_order                  Int         @db.Integer
    uid                          String      @id @db.Char(8)
    page_name                    String      @db.Text
    block_entity                 Json        @db.JsonB @default(dbgenerated())
    block_eyebrow                String      @db.VarChar(64) @default(dbgenerated())
    block_subtitle               String      @db.VarChar(128) @default(dbgenerated())
    block_image                  String?     @db.Text
    @@allow('read', true)
    @@map("lrunes_blocks")
    @@schema("silver")
}

model LrunesDaily {
    record_id                    String      @id @db.Text
    record_date                  DateTime    @db.Date
    draw_kind                    String      @db.Text
    rune_number                  Int         @db.Integer
    direction                    String      @db.Text
    updated_at                   DateTime    @db.Timestamptz(6) @default(now())
    recorded_phase               String?     @db.Text
    @@unique([record_date, draw_kind])
    @@map("lrunes_daily")
    @@schema("silver")
}

model LrunesGalaxy {
    uid                          String      @id @db.Char(8)
    title                        String?     @db.Text
    content                      String?     @db.Text
    createtime                   DateTime?   @db.Timestamptz(6)
    location                     String?     @db.Text
    UpdateTime                   DateTime    @db.Timestamptz(6) @default(now())
    url                          String?     @db.Text
    source_id                    String?     @db.Char(8)
    target_id                    String[]    @db.Text
    ref_id                       String?     @db.Char(8)
    site                         String?     @db.Text
    place_id                     String?     @db.Char(8)
    media_link                   String[]    @db.VarChar
    date                         DateTime?   @db.Date
    site_id                      String?     @db.Text
    statics                      Boolean?     @default(false)
    culture                      Boolean?     @default(false)
    search                       Boolean?     @default(false)
    trace                        Boolean?     @default(false)
    list                         Boolean?     @default(false)
    keyword                      Boolean?     @default(false)
    others                       Boolean?     @default(false)
    extract                      Boolean?     @default(false)
    @@map("lrunes_galaxy")
    @@schema("silver")
}

model Manage {
    id                           String      @id @db.Text
    email                        String?     @db.Text
    domain                       String?     @db.Text
    directory                    String?     @db.Text
    parent_scope_id              String?     @db.Text
    active                       Boolean      @default(true)
    sort_order                   Int         @db.Integer @default(0)
    manage_role                  String?     @db.Text
    galaxy_table                 String      @db.Text @default(dbgenerated())
    anchor_table                 String      @db.Text @default(dbgenerated())
    caches                       Json        @db.JsonB @default(dbgenerated())
    note                         String?     @db.Text
    updatetime                   DateTime    @db.Timestamptz(6) @default(now()) @updatedAt
    @@map("manage")
    @@schema("api")
    @@allow('read', true)
    @@allow('update,delete', auth().roleLevel >= 4)

}

// One signed-in person's preferences; the physical relation is silver.loc_user.
// user_setting replaces the separate api.user_settings key/value table.
// This is not a LOC Auth session issuer or an account-permission registry.
model LocUser {
    uid          String   @id @db.Char(8) @default(dbgenerated())
    userId       String   @unique @db.Text
    email        String   @db.Text
    culture      Json     @db.JsonB @default(dbgenerated())
    statics      Json     @db.JsonB @default(dbgenerated())
    trace        Json     @db.JsonB @default(dbgenerated())
    search       Json     @db.JsonB @default(dbgenerated())
    keyword      String   @db.Text @default("none")
    user_setting Json     @db.JsonB @default(dbgenerated())
    updated_at   DateTime @db.Timestamptz(6) @default(now())
    @@map("loc_user")
    @@schema("silver")
}

model Runes {
    rune_id                      Int         @id @db.SmallInt
    rune_name                    String?     @db.VarChar(1)
    english_name                 String?     @db.VarChar(12)
    totem                        String?     @db.VarChar(2)
    group_name                   String?     @db.VarChar(12)
    moon_phase                   Int?        @db.SmallInt
    card_attr                    Int?        @db.SmallInt
    rune_description             String?     @db.VarChar(40)
    archetype                    String?     @db.VarChar(10)
    char_action                  String?     @db.VarChar(60)
    positive_keywords            String?     @db.Text
    negative_keywords            String?     @db.Text
    extra_rules                  String?     @db.Text
    extra_notes                  String?     @db.Text
    positive_meaning             String?     @db.VarChar(40)
    half_positive_meaning        String?     @db.VarChar(40)
    half_reverse_meaning         String?     @db.VarChar(40)
    reverse_meaning              String?     @db.VarChar(40)
    rune_evolution_history       String?     @db.VarChar(32)
    myth_story                   String?     @db.VarChar(48)
    soul_question                String?     @db.VarChar(16)
    practice_challenge           String?     @db.VarChar(20)
    ritual_advice                String?     @db.VarChar(28)
    harmony_advice               String?     @db.VarChar(32)
    class_enable                 Boolean      @default(true)
    @@map("runes")
    @@schema("silver")
}

model RunesEtc {
    rune_id                      Int         @db.SmallInt
    dir                          Int         @db.SmallInt
    type                         String      @db.VarChar(10)
    desc                         String      @db.VarChar(80)
    current_moon                 String      @db.VarChar @default(dbgenerated())

    @@id([rune_id, dir, type, current_moon])
    @@map("runes_etc")
    @@schema("silver")
}

model RunesGroup {
    group_id                     String      @id @db.VarChar(2)
    english_name                 String      @db.VarChar(10)
    desc                         String      @db.VarChar(40)
    quality                      String      @db.VarChar(10)
    style                        String      @db.VarChar(24)
    runeslist                    Int[]       @db.SmallInt
    @@map("runes_group")
    @@schema("silver")
}

model VisualNovel {
    vn_key                       String      @id @db.Text
    work_key                     String      @db.Text
    record_type                  String      @db.Text
    parent_key                   String?     @db.Text
    target_key                   String?     @db.Text
    relation_type                String?     @db.Text
    part_no                      Int?        @db.SmallInt
    chapter_no                   Int?        @db.SmallInt
    scene_no                     Int?        @db.SmallInt
    sort_order                   Int         @db.Integer @default(0)
    title                        String?     @db.Text
    summary                      String?     @db.Text
    content                      String?     @db.Text
    text_value                   String?     @db.Text
    number_value                 Decimal?    @db.Decimal
    bool_value                   Boolean?
    speaker_key                  String?     @db.Text
    pov_key                      String?     @db.Text
    canon_status                 String      @db.Text @default(dbgenerated())
    status                       String      @db.Text @default(dbgenerated())
    reveal_stage                 String?     @db.Text
    not_before_part              Int?        @db.SmallInt
    not_after_part               Int?        @db.SmallInt
    is_locked                    Boolean      @default(false)
    is_current                   Boolean      @default(true)
    source_kind                  String?     @db.Text
    source_ref                   String?     @db.Text
    source_url                   String?     @db.Text
    source_note                  String?     @db.Text
    created_at                   DateTime    @db.Timestamptz(6) @default(now())
    updated_at                   DateTime    @db.Timestamptz(6) @default(now())
    @@map("VisualNovel")
    @@schema("silver")
}
