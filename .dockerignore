# LOC independent SQL/MCP Deno containers only copy these source trees.
# Avoid uploading the 3000+ repo Skills, Git history, media and extension files.
*
!app
!app/**
!packages
!packages/**
!services
!services/**

# LOC compute image: Wrangler uses the root context ignore file.
!container
!container/loc-compute
!container/loc-compute/Dockerfile
!container/loc-compute/Dockerfile.dockerignore
!container/loc-compute/package.json
!container/loc-compute/pnpm-lock.yaml
!container/loc-compute/server.mjs
!modules
!modules/loc
!modules/loc/dialect
!modules/loc/dialect/sql-workload-policy.mjs
