{
  "$schema": "https://unpkg.com/wrangler@4.157.0/config-schema.json",
  "name": "loc-authority-control",
  "main": "./index.mjs",
  "compatibility_date": "2026-10-31",
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {"name": "LOC_AUTHORITY_STATE", "class_name": "LocAuthorityState"}
    ]
  },
  "exports": {
    "LocAuthorityState": {"type": "durable-object", "storage": "sqlite"}
  },
  "observability": {"enabled": true}
}
