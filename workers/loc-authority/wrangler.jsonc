{
  "$schema": "https://unpkg.com/wrangler@4.157.0/config-schema.json",
  "name": "auth",
  "main": "./index.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "previews": {},
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "auth.lo3rwang.cc",
      "custom_domain": true,
      "zone_name": "lo3rwang.cc"
    }
  ]
}
