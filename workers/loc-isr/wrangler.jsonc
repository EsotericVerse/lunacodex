{
  // LOC ISR runs independently of the static LOC website and LOC Auth.
  // Keep the existing production Worker name and self-service binding stable.
  "name": "loc-isr",
  "main": "../../.open-next/worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "loc-isr",
      "environment": "production"
    }
  ],
  "observability": {
    "enabled": true
  }
}
