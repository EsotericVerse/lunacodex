# Private source material
data/private/

# Node / Next build artifacts
node_modules/
.next/
out/

# Local transient artifacts
.wrangler/
.open-next/
.tmp/
tmp/
.cache/
coverage/
*.log
desktop.ini

# Reproducible, checksum-pinned authored Effekseer sample assets, downloaded during prebuild/predev
public/vendor/effekseer/Collections/
public/vendor/effekseer/effekseer.wasm

# Verified vendor artwork copied from licensed Game-Icons.net at build time
public/vendor/rune-semantic-icons/

# Built/published public snapshots are generated, never manually committed.
/public/_loc/
/public/_loc-building/

# .claude/skills 由 scripts/link-claude-skills.mjs 產生（Windows 用 junction，其餘用 symlink）
# 不進版控：committed symlink 在沒開 core.symlinks 的 Windows 會變成純文字檔
.claude/skills
