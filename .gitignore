# Private source material
data/private/

# Node / Next build artifacts
node_modules/
.next/
# Generated image mirror for direct /pics/ URLs; source stays in assets/pics/
/public/pics/

# Local transient artifacts
.wrangler/
.open-next/
.tmp/
tmp/
.cache/
coverage/
*.log
desktop.ini

# Reproducible, checksum-pinned authored Effekseer sample assets, downloaded during prebuild/predev
public/vendor/effekseer/Collections/
public/vendor/effekseer/effekseer.wasm

# Verified vendor artwork copied from licensed Game-Icons.net at build time
public/vendor/rune-semantic-icons/

# Generated adapters and Next.js types are always reconstructed locally or by CI.
# Their authored sources remain version controlled (app/**/i18n and schema-contract.json).
/app/i18n/page-locale-manifest.js
/packages/zenstack/schema-contract.mjs
/next-env.d.ts

# Page locale assets are generated by predev/prebuild from app/**/i18n/*.json.
# Keep hand-authored route dictionaries in app/ under version control.
/public/i18n/pages/
/public/i18n/shared/

# Built/published public snapshots are generated, never manually committed.
/public/_loc/
/public/_loc-building/

# .claude/skills 由 scripts/sync-claude-skills.mjs 連結至 .agents/skills 的逐項 Junction／Symlink（npm prepare）
# 不進版控：這是產生物，來源是 .agents/skills；改 skill 一律改 .agents，重跑腳本即可同步
.claude/skills

# Generated from the authoritative assets/pics files at prebuild/predev.
/workers/hero-source-manifest.generated.mjs
