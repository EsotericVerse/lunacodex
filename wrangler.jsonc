{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunacodex",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-24",
  "previews": {},
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lunacodex"
    }
  ],
  "observability": {
    "enabled": true
  }
}
