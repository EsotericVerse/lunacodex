{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunacodex",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-24",
  "previews": {
    "hyperdrive": [
      {
        "binding": "LOC_HYPERDRIVE",
        "id": "4305ed11e9f841b7ac0d19e7daecaf9a",
      "localConnectionString": "postgresql://loc_local:loc_local@127.0.0.1:1/loc_local"
      }
    ],
    "r2_buckets": [
      {
        "binding": "LOC_MODEL_CACHE",
        "bucket_name": "loc-isr-incremental-cache"
      }
    ],
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issues": {
        "enabled": false
      }
    }
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "global_navigator"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // OpenNext deploy initializes Wrangler\'s local platform proxy before upload.
  // Loopback is intentionally unreachable; real local dev overrides it via
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_LOC_HYPERDRIVE.
  // Deployed Workers use the Hyperdrive ID, never this local URL.
  "hyperdrive": [
    {
      "binding": "LOC_HYPERDRIVE",
      "id": "4305ed11e9f841b7ac0d19e7daecaf9a",
        "localConnectionString": "postgresql://loc_local:loc_local@127.0.0.1:1/loc_local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOC_MODEL_CACHE",
      "bucket_name": "loc-isr-incremental-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lunacodex"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  }
}
