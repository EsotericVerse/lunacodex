{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunacodex",
  "main": "workers/loc-worker.mjs",
  "compatibility_date": "2026-11-24",
  "previews": {
    "hyperdrive": [
      {
        "binding": "LOC_HYPERDRIVE",
        "id": "4305ed11e9f841b7ac0d19e7daecaf9a",
        "localConnectionString": "postgresql://loc_local:loc_local@127.0.0.1:1/loc_local"
      }
    ],
    "r2_buckets": [
      {
        "binding": "LOC_HERO_ASSETS",
        "bucket_name": "loc-hero-assets"
      }
    ],
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issues": {
        "enabled": false
      }
    }
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "global_navigator"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/pics/LOC-PicAll.webp",
      "/pics/LOC-PicAll_s.webp",
      "/pics/LunaRunes-hero.jpg",
      "/pics/LOC-culture.jpg",
      "/pics/aboutme.webp",
      "/pics/scope-gn.jpg",
      "/pics/LOC-statics.jpg",
      "/pics/LOC-gn.jpg",
      "/pics/LOC-search.jpg"
    ]
  },
  // OpenNext deploy initializes Wrangler's local platform proxy before upload.
  // Loopback is intentionally unreachable; real local dev overrides it via
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_LOC_HYPERDRIVE.
  // Deployed Workers use the Hyperdrive ID, never this local URL.
  "hyperdrive": [
    {
      "binding": "LOC_HYPERDRIVE",
      "id": "4305ed11e9f841b7ac0d19e7daecaf9a",
      "localConnectionString": "postgresql://loc_local:loc_local@127.0.0.1:1/loc_local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOC_HERO_ASSETS",
      "bucket_name": "loc-hero-assets"
    }
  ],
  "containers": [
    {
      "class_name": "LocCompute",
      "image": "./container/loc-compute/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{"name":"LOC_COMPUTE","class_name":"LocCompute"}]
  },
  "migrations": [{"tag":"loc-compute-v1","new_sqlite_classes":["LocCompute"]}],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lunacodex"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  }
}
